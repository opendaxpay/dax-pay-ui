    },
    "./query": {
      "types": "./src/components/query/index.ts",
      "default": "./src/components/query/index.ts"
    },
    "./channel": {
      "types": "./src/components/channel/index.ts",
      "default": "./src/components/channel/index.ts"
    },
    "./enums/payment": {
      "types": "./src/enums/payment/index.ts",
      "default": "./src/enums/payment/index.ts"
    },
    "./enums/payment/channelEnum": {
      "types": "./src/enums/payment/channelEnum.ts",
      "default": "./src/enums/payment/channelEnum.ts"
    },
    "./enums/payment/productEnum": {
      "types": "./src/enums/payment/productEnum.ts",
      "default": "./src/enums/payment/productEnum.ts"
    },
    "./enums/payment/providerEnum": {
      "types": "./src/enums/payment/providerEnum.ts",
      "default": "./src/enums/payment/providerEnum.ts"
    }
  },
  "dependencies": {
    "@vben-core/icons": "workspace:*",
    "@vben/locales": "workspace:*",
    "@vben/utils": "workspace:*",
    "antdv-next": "catalog:",
    "vue": "catalog:"
