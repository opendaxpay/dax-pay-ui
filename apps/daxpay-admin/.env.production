VITE_BASE=/

# 接口地址(生产环境必填: 部署时通过 nginx 反代 /api → 后端, 或运行时注入; 禁用 Vben 默认 mock 地址)
VITE_GLOB_API_URL=

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 关闭开发期 Mock 服务(显式声明, 防止误开)
VITE_NITRO_MOCK=false

# 关闭 Vue DevTools(显式声明, 防止误开)
VITE_DEVTOOLS=false
