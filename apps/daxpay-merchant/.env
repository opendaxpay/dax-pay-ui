# 应用标题
VITE_APP_TITLE='DaxPay Merchant'

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=daxpay-web-merchant

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
# 同时用于支付调试页面私钥等敏感数据的加密存储(packages/stores/src/secure-storage.ts)
VITE_APP_STORE_SECURE_KEY=a751ebb002063900e70806081ba67b22ca3e5b487023043d5c125c8312e27e1f

# 客户端身份码（对齐后端 ClientEnum: admin 运营端 / merchant 商户端），构建期注入请求头与登录/社交参数
VITE_APP_CLIENT_CODE=merchant
