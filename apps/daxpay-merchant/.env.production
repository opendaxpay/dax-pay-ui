VITE_BASE=/

# 接口地址前缀: 生产环境统一走 /api, 由前端 nginx 容器(ui-merchant.conf) location /api/ 反代到后端
# (proxy_pass http://backend:9999/ 结尾斜杠会剥掉 /api 前缀, 后端 controller 无需感知 /api)
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 关闭开发期 Mock 服务(显式声明, 防止误开)
VITE_NITRO_MOCK=false

# 关闭 Vue DevTools(显式声明, 防止误开)
VITE_DEVTOOLS=false
